        "}"}], ",", "0.05", ",", "1.0", ",", "0.05", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
