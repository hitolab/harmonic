Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dxdt", "=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"z", "^", "n"}]}], ")"}]}], "-", 
    RowBox[{"\[Lambda]", "*", "x"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dydt", "=", 
   RowBox[{"x", "-", 
    RowBox[{"\[Lambda]", "*", "y"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dzdt", "=", 
   RowBox[{"y", "-", 
    RowBox[{"\[Lambda]", "*", "z"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"velocity", "=", 
    RowBox[{"{", 
     RowBox[{"dxdt", ",", "dydt", ",", "dzdt"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dt", "=", "dzdt"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ddt", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{"dt", ",", "vars"}], "]"}], ".", "velocity"}], "//", 
    "Simplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dddt", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Grad", "[", 
       RowBox[{"ddt", ",", "vars"}], "]"}], ".", "velocity"}], "//", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dt", "*", "dddt"}], "-", 
        RowBox[{"ddt", "^", "2"}]}], ")"}], "*", 
      RowBox[{
       RowBox[{"(", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SuperscriptBox["z", "n"]}], ")"}], "4"], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"n", " ", 
         SuperscriptBox["z", 
          RowBox[{
           RowBox[{"-", "2"}], "+", "n"}]]}], ")"}]}]}], " ", "//", 
     "Expand"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataPath", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<data.csv\>\""}], 
     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trajectoryRaw", "=", 
   RowBox[{"Import", "[", "dataPath", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trajectoryPoints", "=", 
   RowBox[{"N", "[", 
    RowBox[{"ToExpression", "[", 
     RowBox[{"trajectoryRaw", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"2", ";;"}], ",", 
        RowBox[{"2", ";;", "4"}]}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trajectoryPlot", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Magenta", ",", "Thick"}], "]"}], ",", 
      RowBox[{"Line", "[", "trajectoryPoints", "]"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"viewPointFromAngles", "[", 
    RowBox[{"azimuth_", ",", "elevation_", ",", 
     RowBox[{"distance_", ":", "3"}]}], "]"}], ":=", 
   RowBox[{"distance", "*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "azimuth", "]"}], "*", 
       RowBox[{"Cos", "[", "elevation", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "azimuth", "]"}], "*", 
       RowBox[{"Cos", "[", "elevation", "]"}]}], ",", 
      RowBox[{"Sin", "[", "elevation", "]"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeSurfacePlot", "[", 
    RowBox[{
    "nInput_", ",", "lambdaInput_", ",", "azimuthDeg_", ",", 
     "elevationDeg_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "FPlot", "}"}], ",", 
     RowBox[{
      RowBox[{"FPlot", "=", 
       RowBox[{"F", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "->", "nInput"}], ",", 
          RowBox[{"\[Lambda]", "->", "lambdaInput"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ContourPlot3D", "[", 
         RowBox[{
          RowBox[{"FPlot", "==", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "1.5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "0", ",", "1.5"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "0", ",", "2"}], "}"}], ",", 
          RowBox[{"PlotPoints", "->", "30"}], ",", 
          RowBox[{"Mesh", "->", "None"}], ",", 
          RowBox[{"ContourStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", "Cyan", ",", 
             
             RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
             RowBox[{"Thickness", "[", "0.16", "]"}], ",", 
             RowBox[{"Specularity", "[", 
              RowBox[{"White", ",", "30"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"PerformanceGoal", "->", "\"\<Quality\>\""}]}], "]"}], ",", 
        "trajectoryPlot", ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Inflection Surface F=0 (n = \>\"", ",", "nInput", 
            ",", "\"\<, \[Lambda] = \>\"", ",", "lambdaInput", 
            ",", "\"\<)\>\""}], "}"}], "]"}]}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], 
        ",", 
        RowBox[{"Boxed", "->", "False"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"ViewPoint", "->", 
         RowBox[{"viewPointFromAngles", "[", 
          RowBox[{
           RowBox[{"azimuthDeg", "*", "Degree"}], ",", 
           RowBox[{"elevationDeg", "*", "Degree"}]}], "]"}]}], ",", 
        RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
